[
 {
  "name": "heredoc quoted",
  "command": "python3 <<'EOF'\nprint(1)\nEOF\n",
  "expect": [
   {
    "source": "print(1)\n",
    "label": "heredoc <<EOF"
   }
  ]
 },
 {
  "name": "heredoc double quoted",
  "command": "python3 <<\"PY\"\nx = 2\nPY\n",
  "expect": [
   {
    "source": "x = 2\n",
    "label": "heredoc <<PY"
   }
  ]
 },
 {
  "name": "heredoc bare",
  "command": "python3 << END\nprint(3)\nEND\n",
  "expect": [
   {
    "source": "print(3)\n",
    "label": "heredoc <<END"
   }
  ]
 },
